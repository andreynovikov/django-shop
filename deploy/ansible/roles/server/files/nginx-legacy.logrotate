# The logs that deploy/legacy_redirects.py reads, kept for a year. Their names don't end in .log, so Debian's
# /etc/logrotate.d/nginx leaves them alone.
/var/log/nginx/*_legacy.jsonl {
  monthly
  rotate 12
  missingok
  notifempty
  compress
  delaycompress
  create 0640 www-data adm
  postrotate
  invoke-rc.d nginx rotate >/dev/null 2>&1
  endscript
}
