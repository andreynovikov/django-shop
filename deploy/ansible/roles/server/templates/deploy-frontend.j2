#!/bin/sh
# Forced command of the GitHub deploy key: "<frontend> <tag>" starts that image of a known frontend.
set -euf
# SSH_ORIGINAL_COMMAND is the command line the client sent. It is split into words unquoted, and set -f keeps them
# from expanding as globs.
set -- ${SSH_ORIGINAL_COMMAND-}
[ $# -eq 2 ] || { echo "usage: <frontend> <tag>" >&2; exit 2; }
name=$1 tag=$2
case $name in
{% for site, config in server_frontend_sites.items() %}
  {{ site | quote }}) dir={{ config.directory | quote }} port={{ config.port }} branch={{ config.branch | default(site) | quote }} ;;
{% endfor %}
  *) echo "unknown frontend $name" >&2; exit 2 ;;
esac
# Only the date-and-hash tags of the CI builds, such as 2026.11.11-7f57710, so the tag cannot change the image reference.
# latest is refused too: a deploy names the image of a commit.
case $tag in
  *[!0-9a-f.-]* | '') echo "bad tag $tag" >&2; exit 2 ;;
esac
# The configuration the shared Compose file mounts into the container
[ -f "$dir/.env.storefront" ] || { echo "No $dir/.env.storefront: see Frontend deployment in deploy/README.md" >&2; exit 1; }
STOREFRONT_UID=$(id -u {{ server_app_user | quote }})
STOREFRONT_GID=$(id -g {{ server_app_user | quote }})
export STOREFRONT_UID STOREFRONT_GID
ref={{ server_frontend_registry | quote }}/$branch:$tag
docker pull "$ref" || { echo "No image $ref: has the build of this commit finished?" >&2; exit 1; }
# Ansible sets STOREFRONT_RECREATE=1 after it changed the configuration, which Compose doesn't notice by itself. An ssh
# client can't set it: sshd passes on only the variables of AcceptEnv (LANG and LC_* on Debian).
recreate=
[ "${STOREFRONT_RECREATE-}" != 1 ] || recreate=--force-recreate
# Resolve bind mounts in the storefront directory and ignore any .env file there.
NAME=$name PORT=$port IMAGE=$ref STOREFRONT_BRANCH=$branch \
  docker compose --env-file /dev/null -f /etc/sworld/storefront-compose.yaml --project-directory "$dir" \
  up -d --no-build --pull never $recreate

# Every deploy pulls a new image, and the sworld one, with every product page in it, takes gigabytes once unpacked. Of
# the branch's other images, the two newest stay for a quick rollback (an older one is pulled again). Docker refuses to
# remove an image a container uses, such as production's while stage runs the same branch. A failure here never fails
# the deploy; docker-prune.timer removes what is left after a week.
keep=2
docker image ls --format '{% raw %}{{.CreatedAt}}|{{.Repository}}:{{.Tag}}{% endraw %}' "${ref%:*}" \
  | sort -r | cut -d '|' -f 2 | grep -v -x -F "$ref" | grep -v ':<none>$' | tail -n +$((keep + 1)) \
  | while read -r old; do
      docker image rm "$old" >/dev/null 2>&1 && echo "Removed $old" || true
    done
