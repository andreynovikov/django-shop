#!/bin/sh
# Forced command of the GitHub deploy key: "<frontend> <tag>" starts that image of a known frontend.
set -euf
set -- ${SSH_ORIGINAL_COMMAND-}
[ $# -eq 2 ] || { echo "usage: <frontend> <tag>" >&2; exit 2; }
name=$1 tag=$2
case $name in
{% for site, config in server_frontend_sites.items() %}
  {{ site | quote }}) dir={{ config.directory | quote }} port={{ config.port }} image={{ config.image | default(site) | quote }} ;;
{% endfor %}
  *) echo "unknown frontend $name" >&2; exit 2 ;;
esac
case $tag in
  *[!0-9a-f.-]* | '') echo "bad tag $tag" >&2; exit 2 ;;
esac
STOREFRONT_UID=$(id -u {{ server_app_user | quote }})
STOREFRONT_GID=$(id -g {{ server_app_user | quote }})
export STOREFRONT_UID STOREFRONT_GID
ref=ghcr.io/andreynovikov/$image:$tag
docker pull "$ref" || { echo "No image $ref: has the build of this commit finished?" >&2; exit 1; }
cd "$dir"
NAME=$name PORT=$port IMAGE=$ref docker compose --env-file /dev/null up -d
