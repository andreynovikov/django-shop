# The logs of uWSGI, Celery and Django. nginx writes its logs to /var/log/nginx, where Debian's
# /etc/logrotate.d/nginx rotates them.
/www/*/logs/*uwsgi*.log
/www/*/logs/celery*.log
/www/*/logs/django*.log
/www/*/logs/backup.log
/www/*/logs/kassa.log
/www/*/logs/ozon.log
/www/*/logs/rarus.log
/www/*/logs/sber.log
/www/*/logs/wb.log
/www/*/logs/ym.log
{
  su {{ server_app_user }} www-data
  create 644 {{ server_app_user }} www-data
  copytruncate
  daily
  rotate 7
  compress
  delaycompress
  missingok
  notifempty
}
