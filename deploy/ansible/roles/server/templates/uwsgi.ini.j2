; {{ ansible_managed }}
[uwsgi]
master = true
plugins = python3,logfile
chdir = /www/{{ item.site }}
virtualenv = /www/{{ item.site }}/.venv
module = sewingworld.wsgi:application
; Stop when Django does not load, instead of answering every request with an error
need-app = true
single-interpreter = true
; Each worker loads Django after the fork, which touch-chain-reload below needs
lazy-apps = true
processes = {{ item.processes | default(2) }}
threads = {{ item.threads | default(4) }}
; The workers take turns to accept from the socket, instead of all waking up for each connection
thunder-lock = true
buffer-size = 8192
uid = {{ server_app_user }}
gid = {{ server_app_user }}
chmod-socket = 660
env = PYTHONIOENCODING=UTF-8
{% if item.admin | default(false) %}
env = ADMIN=True
{% endif %}
{% if item.metrics_ports is defined %}
; The ports of the workers' Prometheus exporters, see sewingworld/settings/prometheus.py
env = PROMETHEUS_METRICS_PORTS={{ item.metrics_ports }}
{% endif %}
harakiri = {{ item.harakiri | default(60) }}
vacuum = true
max-requests = 5000
; Megabytes. Restarts a worker that leaks before the OOM killer stops it.
reload-on-rss = 600
; Touching the file reloads the workers one after another, so the app keeps answering during a deploy
touch-chain-reload = /www/{{ item.site }}/.touch_reload
logger = file:/www/{{ item.site }}/logs/{{ 'admin_' if item.admin | default(false) else '' }}uwsgi_error.log
log-date = true
; nginx logs every request with its time, uWSGI only the failed ones and those slower than 2 s
disable-logging = true
log-5xx = true
log-slow = 2000
{% if item.stats is defined %}
stats = {{ item.stats }}
stats-http = true
{% endif %}
{% for key, value in (item.options | default({})).items() %}
{{ key }} = {{ value }}
{% endfor %}
