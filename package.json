{
  "name": "sworld",
  "version": "2026.10.07",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3004 --experimental-https",
    "test": "next dev -H 127.0.0.1 -p 4004",
    "start": "next start -H 127.0.0.1 -p 4004",
    "lint": "eslint src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build": "next build",
    "docker-build": "NAME=stage IMAGE=sworld:$npm_package_version PORT=4004 docker compose build && docker tag sworld sworld:$npm_package_version",
    "docker-deploy": "NAME=stage IMAGE=sworld:$npm_package_version PORT=4004 docker compose up -d",
    "vars": "printenv | grep npm"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@maskito/core": "^5.5.0",
    "@maskito/kit": "^5.5.0",
    "@maskito/react": "^5.5.0",
    "@popperjs/core": "^2.11.8",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "ejs": "^5.0.2",
    "gana": "^1.1.1",
    "libphonenumber-js": "^1.13.14",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "next": "^16.3.6",
    "nuqs": "^2.10.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-typeahead": "^6.4.1",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^11.0.1",
    "sanitize-html": "^2.17.7",
    "simplebar-react": "^3.3.2",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-query": "^5.104.0",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "sass": "^1.100.0",
    "typescript": "^6.0.3"
  }
}
